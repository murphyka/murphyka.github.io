@article{murphy2022distributed,
  title={The distributed information bottleneck reveals the explanatory structure of complex systems},
  author={Murphy, Kieran A. and Bassett, Dani S.},
  journal={arXiv preprint arXiv:2204.07576},
  year={2022},
  url={https://arxiv.org/abs/2204.07576},
  blurb={Where is the information in a relationship between an input and an output?  What are the most important parts of the input?  We show how to address these fundamental questions by turning a relationship into a scheme of approximations that gradually reduce the amount of information utilized while maximizing fidelity.  Smearing a relationship out in this way brings interpretability to deep learning and illuminates the nature of complex systems, without requiring dataset modifications or a neural network architecture more exotic than a VAE.}
}

@article{vit_ib,
  title={From independent patches to coordinated attention: Controlling information flow in vision transformers},
  author={Murphy, Kieran A.},
  journal={ICML "Mechanistic Interpretability" workshop},
  year={2026},
  url={https://arxiv.org/abs/2602.04784},
  blurb={The attention modules in a transformer are the only points where residual streams communicate.  Let's impose a penalty on the information the attention modules use, across all heads simultaneously, to create a family of transformers that use attention sparingly and selectively, so as to create a new form of interpretability in transformer information processing.  In this paper, we lay the groundwork with vision transformers trained on a subset of imagenet, and find that the first essential piece of information to be passed around between patch representations consistently involves detecting repetition elsewhere in the image.},
  preview={schematic_vit_ib.png},
  awards={Workshop paper}
}




